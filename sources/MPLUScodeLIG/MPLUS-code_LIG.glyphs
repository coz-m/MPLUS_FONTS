{
code = "# ==============================================================================
# calt - Contextual Alternates
# M PLUS 1 Code LIG (variable font, weight x width), Glyphs 4
# Version: 99.5
#
# GENERATED by make_calt.py from the ligature glyph list (378 ligatures).
# Do not edit by hand: change the glyph list and run the generator again.
#
# License: same as the font. Add your project's copyright / license header here.
# ==============================================================================
#
# OVERVIEW
#   1. LONG_OPERATORS   Ligatures that the box-line rules would otherwise rewrite
#                       (less_equal_equal_greater less_hyphen_hyphen_asciitilde
#                       less_hyphen_hyphen_greater).
#   2. Box lines        Runs of \"=\" or \"-\" combined with \"|\", \"<\", \">\" are drawn
#                       with the *.linear glyph family (continuous lines).
#   3. Underscore, #    Runs of \"_\" and \"#\" are drawn as one line.
#   4. Dotted lines     Long runs of \".\" or \":\" are spaced evenly.
#   5. LIG_n            Ordinary ligatures, longest first (10, 4, 3, 2).
#                       The first glyph of the sequence is replaced by the ligature
#                       glyph, the remaining cells by LIG.space (every glyph keeps a
#                       one-cell advance, also the long ones such as mplusfonts).
#
# *.linear GLYPH FAMILY  (X = equal or hyphen; every glyph is one cell wide)
#   X-left.linear       left end of a line   (LSB normal, RSB overlaps the next cell)
#   X.linear            middle of a line     (overlaps both neighbours)
#   X-right.linear      right end of a line  (overlaps the previous cell, RSB normal)
#   bar-X.linear        \"|\" followed by X
#   X-bar.linear        X followed by \"|\"
#   X-bar-X.linear      \"|\" between X on both sides (cross)
#   less-X.linear       \"<\" followed by X          (left arrow head)
#   X-greater.linear    X followed by \">\"          (right arrow head)
#   underscore-left.linear / underscore.linear / underscore-right.linear
#   numbersign-left.linear / numbersign.linear / numbersign-right.linear
#   period.linear, colon.linear   one centred dot per cell (no left/right variants)
#
# BEHAVIOUR (X = \"=\" or \"-\")
#   runs up to the longest ligature of X stay ligatures (equal_equal, equal_equal_equal, hyphen_hyphen, hyphen_hyphen_hyphen)
#   longer runs                X-left.linear + X.linear * n + X-right.linear
#   X next to | < >            always joined with the *.linear glyphs, never ligatures
#   \"|\" with X on both sides   X-bar-X.linear
#   |:===|===:|                the colons act as caps; the lines continue through them
#   A line of exactly three cells that has its own ligature glyph uses that glyph
#   (bar_equal_equal bar_equal_greater bar_hyphen_greater bar_hyphen_hyphen
#   equal_equal_bar equal_equal_greater hyphen_hyphen_bar
#   hyphen_hyphen_greater less_equal_equal less_hyphen_hyphen).
#   Four or more cells, or a bar/head on the other end, make a line.
#
# BEHAVIOUR (single glyphs)
#   _  (from 2 in a row)   underscore-left + underscore * n + underscore-right
#   #  (from 2 in a row)   numbersign-left + numbersign * n + numbersign-right
#   .  (from 4 in a row)   period.linear in every cell
#   :  (from 4 in a row)   colon.linear in every cell
#
# ENGINE NOTES (read before editing)
#   * A lookup that is referenced several times in a feature runs only ONCE.
#     Every pass is therefore a separate, uniquely named lookup.
#   * Rule order inside a lookup is NOT reliable. Some compilers (the one used by
#     Glyphs among them) re-sort contextual rules, e.g. longest backtrack first.
#     All box-line lookups are written so that rules never compete: either the
#     contexts exclude each other, or every rule of a lookup produces the same
#     glyph. Priorities are expressed by splitting rules into separate lookups.
#     Never rely on \"ignore sub\" or on the order of rules in these lookups.
#   * Inside one lookup, glyphs are processed left to right. The backtrack
#     sequence sees glyphs already substituted in the same lookup, the lookahead
#     sequence sees the original glyphs.
#   * LONG_OPERATORS and LIG_n do depend on one order: rules that look at the
#     preceding ligature (chain rules, non-empty backtrack) must win over rules
#     that start a new ligature (empty backtrack). This also holds when the
#     compiler sorts by backtrack length. Keep each group in the given order.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LONG_OPERATORS: ligatures that must be claimed before the box-line rules.
# ------------------------------------------------------------------------------
lookup LONG_OPERATORS {
	# chain: cells that follow a ligature become LIG.space
	sub less_equal_equal_greater equal' equal greater by LIG.space;
	sub less_equal_equal_greater LIG.space equal' greater by LIG.space;
	sub less_equal_equal_greater LIG.space LIG.space greater' by LIG.space;
	sub less_hyphen_hyphen_asciitilde hyphen' hyphen asciitilde by LIG.space;
	sub less_hyphen_hyphen_asciitilde LIG.space hyphen' asciitilde by LIG.space;
	sub less_hyphen_hyphen_asciitilde LIG.space LIG.space asciitilde' by LIG.space;
	sub less_hyphen_hyphen_greater hyphen' hyphen greater by LIG.space;
	sub less_hyphen_hyphen_greater LIG.space hyphen' greater by LIG.space;
	sub less_hyphen_hyphen_greater LIG.space LIG.space greater' by LIG.space;
	# sub: ligature formation
	sub less' equal equal greater by less_equal_equal_greater;
	sub less' hyphen hyphen asciitilde by less_hyphen_hyphen_asciitilde;
	sub less' hyphen hyphen greater by less_hyphen_hyphen_greater;
} LONG_OPERATORS;

# ------------------------------------------------------------------------------
# Box lines and arrows made of \"=\" (glyph name: equal)
#    A line is a cluster of three or more cells. A cluster of exactly two cells
#    (|=, =|, <=, =>) stays an ordinary ligature.
# ------------------------------------------------------------------------------

# BARS_CROSS: \"|\" with = on both sides.
lookup BARS_CROSS_EQUAL {
	sub equal bar' equal by equal-bar-equal.linear;
} BARS_CROSS_EQUAL;

# BARS_START: \"|\" that starts a line (a cross has already been taken).
lookup BARS_START_EQUAL {
	sub bar' equal equal by bar-equal.linear;                 # |==
	sub bar' equal bar by bar-equal.linear;                 # |=|
	sub bar' equal greater by bar-equal.linear;             # |=>
} BARS_START_EQUAL;

# BARS_END: \"|\" that ends a line.
lookup BARS_END_EQUAL {
	sub equal equal bar' by equal-bar.linear;                 # ==|
	sub [bar bar-equal.linear equal-bar.linear] equal bar' by equal-bar.linear;       # |=|
	sub less equal bar' by equal-bar.linear;                 # <=|
} BARS_END_EQUAL;

# HEADS: \"<\" and \">\" join a line when two or more shaft cells exist, or when a
# bar is on the other end of a single shaft cell.
lookup HEADS_EQUAL {
	sub [equal equal.linear] [equal equal.linear] greater' by equal-greater.linear;       # ==> (the shaft may already be joined)
	sub [bar-equal.linear equal-bar-equal.linear] equal greater' by equal-greater.linear;            # |=>
	sub less' equal equal by less-equal.linear;                     # <==
	sub less' equal [equal-bar.linear equal-bar-equal.linear] by less-equal.linear;                # <=|
} HEADS_EQUAL;

# RIGHTWARD: every = right of a line start becomes equal.linear (unlimited length).
lookup RIGHTWARD_EQUAL {
	sub [bar-equal.linear equal-bar-equal.linear equal.linear less-equal.linear] equal' by equal.linear;
	sub bar colon equal' by equal.linear;                  # |:=== start cap
	sub equal' colon bar by equal.linear;                  # ===:| end cap (anchor for RUN)
} RIGHTWARD_EQUAL;

# RUN: converts raw = cells that belong to a line.
#   1. 4 or more raw cells in a row: every cell that has 3 more raw cells to its right
#      (a plain run longer than the longest ligature is a line, whatever is around it)
#   2. the last cells of such a run (they follow a converted cell)
#   3. a short run directly left of a joined glyph: |=, =|, =>
lookup RUN_EQUAL {
	sub equal' equal equal equal by equal.linear;
	sub equal.linear equal' by equal.linear;
	sub equal' [equal-bar.linear equal-bar-equal.linear equal.linear equal-greater.linear] by equal.linear;
	sub equal' equal [equal-bar.linear equal-bar-equal.linear equal.linear equal-greater.linear] by equal.linear;
	sub equal' equal equal [equal-bar.linear equal-bar-equal.linear equal.linear equal-greater.linear] by equal.linear;
} RUN_EQUAL;

# ENDS: give the first and the last cell of every line its end glyph.
# MARK:  every equal.linear that has a line glyph on its left becomes equal-right.linear (temporary marker).
lookup ENDS_MARK_EQUAL {
	sub [bar-equal.linear equal-bar-equal.linear equal.linear equal-right.linear less-equal.linear] equal.linear' by equal-right.linear;
	sub bar colon equal.linear' by equal-right.linear;                  # the cell after a start cap continues the line
} ENDS_MARK_EQUAL;

# LEFT:  the equal.linear that was not marked has nothing on its left: it is the left end.
lookup ENDS_LEFT_EQUAL {
	sub equal.linear' by equal-left.linear;
} ENDS_LEFT_EQUAL;

# BACK:  a marker with another line glyph on its right is a middle cell again.
lookup ENDS_BACK_EQUAL {
	sub equal-right.linear' [equal-right.linear equal-bar.linear equal-bar-equal.linear equal-greater.linear] by equal.linear;
	sub equal-right.linear' colon bar by equal.linear;                  # cell before an end cap
} ENDS_BACK_EQUAL;

# LINE_LIGS: a line of exactly three cells that has its own ligature glyph is drawn with it.
# Longer lines, and lines that touch another bar/head, have another glyph sequence and are
# not matched. Every rule marks a different glyph or has a different backtrack, so the
# order of the rules does not matter.
lookup LINE_LIGS_EQUAL {
	sub equal-left.linear' equal.linear equal-greater.linear by equal_equal_greater;
	sub equal_equal_greater equal.linear' equal-greater.linear by LIG.space;
	sub equal_equal_greater LIG.space equal-greater.linear' by LIG.space;
	sub equal-left.linear' equal.linear equal-bar.linear by equal_equal_bar;
	sub equal_equal_bar equal.linear' equal-bar.linear by LIG.space;
	sub equal_equal_bar LIG.space equal-bar.linear' by LIG.space;
	sub less-equal.linear' equal.linear equal-right.linear by less_equal_equal;
	sub less_equal_equal equal.linear' equal-right.linear by LIG.space;
	sub less_equal_equal LIG.space equal-right.linear' by LIG.space;
	sub bar-equal.linear' equal.linear equal-right.linear by bar_equal_equal;
	sub bar_equal_equal equal.linear' equal-right.linear by LIG.space;
	sub bar_equal_equal LIG.space equal-right.linear' by LIG.space;
	sub bar-equal.linear' equal.linear equal-greater.linear by bar_equal_greater;
	sub bar_equal_greater equal.linear' equal-greater.linear by LIG.space;
	sub bar_equal_greater LIG.space equal-greater.linear' by LIG.space;
} LINE_LIGS_EQUAL;

# ------------------------------------------------------------------------------
# Box lines and arrows made of \"-\" (glyph name: hyphen)
#    A line is a cluster of three or more cells. A cluster of exactly two cells
#    (|-, -|, <-, ->) stays an ordinary ligature.
# ------------------------------------------------------------------------------

# BARS_CROSS: \"|\" with - on both sides.
lookup BARS_CROSS_HYPHEN {
	sub hyphen bar' hyphen by hyphen-bar-hyphen.linear;
} BARS_CROSS_HYPHEN;

# BARS_START: \"|\" that starts a line (a cross has already been taken).
lookup BARS_START_HYPHEN {
	sub bar' hyphen hyphen by bar-hyphen.linear;                 # |--
	sub bar' hyphen bar by bar-hyphen.linear;                 # |-|
	sub bar' hyphen greater by bar-hyphen.linear;             # |->
} BARS_START_HYPHEN;

# BARS_END: \"|\" that ends a line.
lookup BARS_END_HYPHEN {
	sub hyphen hyphen bar' by hyphen-bar.linear;                 # --|
	sub [bar bar-hyphen.linear hyphen-bar.linear] hyphen bar' by hyphen-bar.linear;       # |-|
	sub less hyphen bar' by hyphen-bar.linear;                 # <-|
} BARS_END_HYPHEN;

# HEADS: \"<\" and \">\" join a line when two or more shaft cells exist, or when a
# bar is on the other end of a single shaft cell.
lookup HEADS_HYPHEN {
	sub [hyphen hyphen.linear] [hyphen hyphen.linear] greater' by hyphen-greater.linear;       # --> (the shaft may already be joined)
	sub [bar-hyphen.linear hyphen-bar-hyphen.linear] hyphen greater' by hyphen-greater.linear;            # |->
	sub less' hyphen hyphen by less-hyphen.linear;                     # <--
	sub less' hyphen [hyphen-bar.linear hyphen-bar-hyphen.linear] by less-hyphen.linear;                # <-|
} HEADS_HYPHEN;

# RIGHTWARD: every - right of a line start becomes hyphen.linear (unlimited length).
lookup RIGHTWARD_HYPHEN {
	sub [bar-hyphen.linear hyphen-bar-hyphen.linear hyphen.linear less-hyphen.linear] hyphen' by hyphen.linear;
	sub bar colon hyphen' by hyphen.linear;                  # |:=== start cap
	sub hyphen' colon bar by hyphen.linear;                  # ===:| end cap (anchor for RUN)
} RIGHTWARD_HYPHEN;

# RUN: converts raw - cells that belong to a line.
#   1. 4 or more raw cells in a row: every cell that has 3 more raw cells to its right
#      (a plain run longer than the longest ligature is a line, whatever is around it)
#   2. the last cells of such a run (they follow a converted cell)
#   3. a short run directly left of a joined glyph: |-, -|, ->
lookup RUN_HYPHEN {
	sub hyphen' hyphen hyphen hyphen by hyphen.linear;
	sub hyphen.linear hyphen' by hyphen.linear;
	sub hyphen' [hyphen-bar.linear hyphen-bar-hyphen.linear hyphen.linear hyphen-greater.linear] by hyphen.linear;
	sub hyphen' hyphen [hyphen-bar.linear hyphen-bar-hyphen.linear hyphen.linear hyphen-greater.linear] by hyphen.linear;
	sub hyphen' hyphen hyphen [hyphen-bar.linear hyphen-bar-hyphen.linear hyphen.linear hyphen-greater.linear] by hyphen.linear;
} RUN_HYPHEN;

# ENDS: give the first and the last cell of every line its end glyph.
# MARK:  every hyphen.linear that has a line glyph on its left becomes hyphen-right.linear (temporary marker).
lookup ENDS_MARK_HYPHEN {
	sub [bar-hyphen.linear hyphen-bar-hyphen.linear hyphen.linear hyphen-right.linear less-hyphen.linear] hyphen.linear' by hyphen-right.linear;
	sub bar colon hyphen.linear' by hyphen-right.linear;                  # the cell after a start cap continues the line
} ENDS_MARK_HYPHEN;

# LEFT:  the hyphen.linear that was not marked has nothing on its left: it is the left end.
lookup ENDS_LEFT_HYPHEN {
	sub hyphen.linear' by hyphen-left.linear;
} ENDS_LEFT_HYPHEN;

# BACK:  a marker with another line glyph on its right is a middle cell again.
lookup ENDS_BACK_HYPHEN {
	sub hyphen-right.linear' [hyphen-right.linear hyphen-bar.linear hyphen-bar-hyphen.linear hyphen-greater.linear] by hyphen.linear;
	sub hyphen-right.linear' colon bar by hyphen.linear;                  # cell before an end cap
} ENDS_BACK_HYPHEN;

# LINE_LIGS: a line of exactly three cells that has its own ligature glyph is drawn with it.
# Longer lines, and lines that touch another bar/head, have another glyph sequence and are
# not matched. Every rule marks a different glyph or has a different backtrack, so the
# order of the rules does not matter.
lookup LINE_LIGS_HYPHEN {
	sub hyphen-left.linear' hyphen.linear hyphen-greater.linear by hyphen_hyphen_greater;
	sub hyphen_hyphen_greater hyphen.linear' hyphen-greater.linear by LIG.space;
	sub hyphen_hyphen_greater LIG.space hyphen-greater.linear' by LIG.space;
	sub hyphen-left.linear' hyphen.linear hyphen-bar.linear by hyphen_hyphen_bar;
	sub hyphen_hyphen_bar hyphen.linear' hyphen-bar.linear by LIG.space;
	sub hyphen_hyphen_bar LIG.space hyphen-bar.linear' by LIG.space;
	sub less-hyphen.linear' hyphen.linear hyphen-right.linear by less_hyphen_hyphen;
	sub less_hyphen_hyphen hyphen.linear' hyphen-right.linear by LIG.space;
	sub less_hyphen_hyphen LIG.space hyphen-right.linear' by LIG.space;
	sub bar-hyphen.linear' hyphen.linear hyphen-right.linear by bar_hyphen_hyphen;
	sub bar_hyphen_hyphen hyphen.linear' hyphen-right.linear by LIG.space;
	sub bar_hyphen_hyphen LIG.space hyphen-right.linear' by LIG.space;
	sub bar-hyphen.linear' hyphen.linear hyphen-greater.linear by bar_hyphen_greater;
	sub bar_hyphen_greater hyphen.linear' hyphen-greater.linear by LIG.space;
	sub bar_hyphen_greater LIG.space hyphen-greater.linear' by LIG.space;
} LINE_LIGS_HYPHEN;

# ------------------------------------------------------------------------------
# underscore lines: 2 or more \"_\" become one line.
# ------------------------------------------------------------------------------
lookup UNDERSCORE_RUN {
	sub underscore' underscore by underscore.linear;
	sub underscore.linear underscore' by underscore.linear;
} UNDERSCORE_RUN;

lookup UNDERSCORE_MARK {
	sub [underscore.linear underscore-right.linear] underscore.linear' by underscore-right.linear;
} UNDERSCORE_MARK;

lookup UNDERSCORE_LEFT {
	sub underscore.linear' by underscore-left.linear;
} UNDERSCORE_LEFT;

lookup UNDERSCORE_BACK {
	sub underscore-right.linear' underscore-right.linear by underscore.linear;
} UNDERSCORE_BACK;

# ------------------------------------------------------------------------------
# numbersign lines: 2 or more \"#\" become one line.
# ------------------------------------------------------------------------------
lookup NUMBERSIGN_RUN {
	sub numbersign' numbersign by numbersign.linear;
	sub numbersign.linear numbersign' by numbersign.linear;
} NUMBERSIGN_RUN;

lookup NUMBERSIGN_MARK {
	sub [numbersign.linear numbersign-right.linear] numbersign.linear' by numbersign-right.linear;
} NUMBERSIGN_MARK;

lookup NUMBERSIGN_LEFT {
	sub numbersign.linear' by numbersign-left.linear;
} NUMBERSIGN_LEFT;

lookup NUMBERSIGN_BACK {
	sub numbersign-right.linear' numbersign-right.linear by numbersign.linear;
} NUMBERSIGN_BACK;

# ------------------------------------------------------------------------------
# Dotted lines: one centred glyph per cell, so the dots are spaced evenly.
# ------------------------------------------------------------------------------
lookup DOTS_PERIOD {
	sub period' period period period by period.linear;
	sub period.linear period' by period.linear;
} DOTS_PERIOD;

lookup DOTS_COLON {
	sub colon' colon colon colon by colon.linear;
	sub colon.linear colon' by colon.linear;
} DOTS_COLON;

# ------------------------------------------------------------------------------
# Ordinary ligatures. Within each lookup: chain rules first, then sub rules.
# ------------------------------------------------------------------------------

lookup LIG_10 {
	# chain: cells that follow a ligature become LIG.space
	sub m_p_l_u_s_f_o_n_t_s p' l u s f o n t s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space l' u s f o n t s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space LIG.space u' s f o n t s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space LIG.space LIG.space s' f o n t s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space LIG.space LIG.space LIG.space f' o n t s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space LIG.space LIG.space LIG.space LIG.space o' n t s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space LIG.space LIG.space LIG.space LIG.space LIG.space n' t s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space LIG.space LIG.space LIG.space LIG.space LIG.space LIG.space t' s by LIG.space;
	sub m_p_l_u_s_f_o_n_t_s LIG.space LIG.space LIG.space LIG.space LIG.space LIG.space LIG.space LIG.space s' by LIG.space;
	# sub: ligature formation
	sub m' p l u s f o n t s by m_p_l_u_s_f_o_n_t_s;
} LIG_10;

lookup LIG_4 {
	# chain: cells that follow a ligature become LIG.space
	sub bar_bar_bar_greater bar' bar greater by LIG.space;
	sub bar_bar_bar_greater LIG.space bar' greater by LIG.space;
	sub bar_bar_bar_greater LIG.space LIG.space greater' by LIG.space;
	sub colon_colon_less_greater colon' less greater by LIG.space;
	sub colon_colon_less_greater LIG.space less' greater by LIG.space;
	sub colon_colon_less_greater LIG.space LIG.space greater' by LIG.space;
	sub greater_greater_greater_equal greater' greater equal by LIG.space;
	sub greater_greater_greater_equal LIG.space greater' equal by LIG.space;
	sub greater_greater_greater_equal LIG.space LIG.space equal' by LIG.space;
	sub hyphen_hyphen_bracketleft_bracketleft hyphen' bracketleft bracketleft by LIG.space;
	sub hyphen_hyphen_bracketleft_bracketleft LIG.space bracketleft' bracketleft by LIG.space;
	sub hyphen_hyphen_bracketleft_bracketleft LIG.space LIG.space bracketleft' by LIG.space;
	sub hyphen_hyphen_bracketright_bracketright hyphen' bracketright bracketright by LIG.space;
	sub hyphen_hyphen_bracketright_bracketright LIG.space bracketright' bracketright by LIG.space;
	sub hyphen_hyphen_bracketright_bracketright LIG.space LIG.space bracketright' by LIG.space;
	sub hyphen_hyphen_exclam_greater hyphen' exclam greater by LIG.space;
	sub hyphen_hyphen_exclam_greater LIG.space exclam' greater by LIG.space;
	sub hyphen_hyphen_exclam_greater LIG.space LIG.space greater' by LIG.space;
	sub less_bar_bar_bar bar' bar bar by LIG.space;
	sub less_bar_bar_bar LIG.space bar' bar by LIG.space;
	sub less_bar_bar_bar LIG.space LIG.space bar' by LIG.space;
	sub less_dollar_exclam_greater dollar' exclam greater by LIG.space;
	sub less_dollar_exclam_greater LIG.space exclam' greater by LIG.space;
	sub less_dollar_exclam_greater LIG.space LIG.space greater' by LIG.space;
	sub less_exclam_hyphen_hyphen exclam' hyphen hyphen by LIG.space;
	sub less_exclam_hyphen_hyphen LIG.space hyphen' hyphen by LIG.space;
	sub less_exclam_hyphen_hyphen LIG.space LIG.space hyphen' by LIG.space;
	sub less_numbersign_hyphen_hyphen numbersign' hyphen hyphen by LIG.space;
	sub less_numbersign_hyphen_hyphen LIG.space hyphen' hyphen by LIG.space;
	sub less_numbersign_hyphen_hyphen LIG.space LIG.space hyphen' by LIG.space;
	sub parenleft_question_less_equal question' less equal by LIG.space;
	sub parenleft_question_less_equal LIG.space less' equal by LIG.space;
	sub parenleft_question_less_equal LIG.space LIG.space equal' by LIG.space;
	sub parenleft_question_less_exclam question' less exclam by LIG.space;
	sub parenleft_question_less_exclam LIG.space less' exclam by LIG.space;
	sub parenleft_question_less_exclam LIG.space LIG.space exclam' by LIG.space;
	sub percent_T_greater_percent T' greater percent by LIG.space;
	sub percent_T_greater_percent LIG.space greater' percent by LIG.space;
	sub percent_T_greater_percent LIG.space LIG.space percent' by LIG.space;
	sub percent_i_n_percent i' n percent by LIG.space;
	sub percent_i_n_percent LIG.space n' percent by LIG.space;
	sub percent_i_n_percent LIG.space LIG.space percent' by LIG.space;
	sub percent_less_greater_percent less' greater percent by LIG.space;
	sub percent_less_greater_percent LIG.space greater' percent by LIG.space;
	sub percent_less_greater_percent LIG.space LIG.space percent' by LIG.space;
	sub period_period_period_question period' period question by LIG.space;
	sub period_period_period_question LIG.space period' question by LIG.space;
	sub period_period_period_question LIG.space LIG.space question' by LIG.space;
	sub two_greater_ampersand_one greater' ampersand one by LIG.space;
	sub two_greater_ampersand_one LIG.space ampersand' one by LIG.space;
	sub two_greater_ampersand_one LIG.space LIG.space one' by LIG.space;
	# sub: ligature formation
	sub bar' bar bar greater by bar_bar_bar_greater;
	sub colon' colon less greater by colon_colon_less_greater;
	sub greater' greater greater equal by greater_greater_greater_equal;
	sub hyphen' hyphen bracketleft bracketleft by hyphen_hyphen_bracketleft_bracketleft;
	sub hyphen' hyphen bracketright bracketright by hyphen_hyphen_bracketright_bracketright;
	sub hyphen' hyphen exclam greater by hyphen_hyphen_exclam_greater;
	sub less' bar bar bar by less_bar_bar_bar;
	sub less' dollar exclam greater by less_dollar_exclam_greater;
	sub less' exclam hyphen hyphen by less_exclam_hyphen_hyphen;
	sub less' numbersign hyphen hyphen by less_numbersign_hyphen_hyphen;
	sub parenleft' question less equal by parenleft_question_less_equal;
	sub parenleft' question less exclam by parenleft_question_less_exclam;
	sub percent' T greater percent by percent_T_greater_percent;
	sub percent' i n percent by percent_i_n_percent;
	sub percent' less greater percent by percent_less_greater_percent;
	sub period' period period question by period_period_period_question;
	sub two' greater ampersand one by two_greater_ampersand_one;
} LIG_4;

lookup LIG_3 {
	# chain: cells that follow a ligature become LIG.space
	sub ampersand_ampersand_ampersand ampersand' ampersand by LIG.space;
	sub ampersand_ampersand_ampersand LIG.space ampersand' by LIG.space;
	sub ampersand_ampersand_equal ampersand' equal by LIG.space;
	sub ampersand_ampersand_equal LIG.space equal' by LIG.space;
