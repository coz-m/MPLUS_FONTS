	sub asciitilde_hyphen_greater hyphen' greater by LIG.space;
	sub asciitilde_hyphen_greater LIG.space greater' by LIG.space;
	sub asterisk_asterisk_asterisk asterisk' asterisk by LIG.space;
	sub asterisk_asterisk_asterisk LIG.space asterisk' by LIG.space;
	sub asterisk_asterisk_equal asterisk' equal by LIG.space;
	sub asterisk_asterisk_equal LIG.space equal' by LIG.space;
	sub asterisk_asterisk_slash asterisk' slash by LIG.space;
	sub asterisk_asterisk_slash LIG.space slash' by LIG.space;
	sub at_at_greater at' greater by LIG.space;
	sub at_at_greater LIG.space greater' by LIG.space;
	sub at_equal_less equal' less by LIG.space;
	sub at_equal_less LIG.space less' by LIG.space;
	sub at_greater_equal greater' equal by LIG.space;
	sub at_greater_equal LIG.space equal' by LIG.space;
	sub backslash_equal_equal equal' equal by LIG.space;
	sub backslash_equal_equal LIG.space equal' by LIG.space;
	sub bar_bar_bar bar' bar by LIG.space;
	sub bar_bar_bar LIG.space bar' by LIG.space;
	sub bar_bar_equal bar' equal by LIG.space;
	sub bar_bar_equal LIG.space equal' by LIG.space;
	sub bar_bar_greater bar' greater by LIG.space;
	sub bar_bar_greater LIG.space greater' by LIG.space;
	sub bar_bar_hyphen bar' hyphen by LIG.space;
	sub bar_bar_hyphen LIG.space hyphen' by LIG.space;
	sub bar_underscore_bar underscore' bar by LIG.space;
	sub bar_underscore_bar LIG.space bar' by LIG.space;
	sub braceleft_braceleft_greater braceleft' greater by LIG.space;
	sub braceleft_braceleft_greater LIG.space greater' by LIG.space;
	sub braceleft_braceleft_hyphen braceleft' hyphen by LIG.space;
	sub braceleft_braceleft_hyphen LIG.space hyphen' by LIG.space;
	sub braceleft_braceleft_numbersign braceleft' numbersign by LIG.space;
	sub braceleft_braceleft_numbersign LIG.space numbersign' by LIG.space;
	sub braceleft_braceleft_slash braceleft' slash by LIG.space;
	sub braceleft_braceleft_slash LIG.space slash' by LIG.space;
	sub braceleft_hyphen_numbersign hyphen' numbersign by LIG.space;
	sub braceleft_hyphen_numbersign LIG.space numbersign' by LIG.space;
	sub bracketright_bracketright_greater bracketright' greater by LIG.space;
	sub bracketright_bracketright_greater LIG.space greater' by LIG.space;
	sub colon_asciitilde_colon asciitilde' colon by LIG.space;
	sub colon_asciitilde_colon LIG.space colon' by LIG.space;
	sub colon_asterisk_colon asterisk' colon by LIG.space;
	sub colon_asterisk_colon LIG.space colon' by LIG.space;
	sub colon_colon_colon colon' colon by LIG.space;
	sub colon_colon_colon LIG.space colon' by LIG.space;
	sub colon_colon_equal colon' equal by LIG.space;
	sub colon_colon_equal LIG.space equal' by LIG.space;
	sub colon_colon_greater colon' greater by LIG.space;
	sub colon_colon_greater LIG.space greater' by LIG.space;
	sub colon_colon_less colon' less by LIG.space;
	sub colon_colon_less LIG.space less' by LIG.space;
	sub colon_greater_colon greater' colon by LIG.space;
	sub colon_greater_colon LIG.space colon' by LIG.space;
	sub colon_greater_greater greater' greater by LIG.space;
	sub colon_greater_greater LIG.space greater' by LIG.space;
	sub colon_hyphen_greater hyphen' greater by LIG.space;
	sub colon_hyphen_greater LIG.space greater' by LIG.space;
	sub colon_less_colon less' colon by LIG.space;
	sub colon_less_colon LIG.space colon' by LIG.space;
	sub colon_plus_colon plus' colon by LIG.space;
	sub colon_plus_colon LIG.space colon' by LIG.space;
	sub colon_question_greater question' greater by LIG.space;
	sub colon_question_greater LIG.space greater' by LIG.space;
	sub dollar_at_quotedbl at' quotedbl by LIG.space;
	sub dollar_at_quotedbl LIG.space quotedbl' by LIG.space;
	sub equal_backslash_equal backslash' equal by LIG.space;
	sub equal_backslash_equal LIG.space equal' by LIG.space;
	sub equal_colon_equal colon' equal by LIG.space;
	sub equal_colon_equal LIG.space equal' by LIG.space;
	sub equal_equal_equal equal' equal by LIG.space;
	sub equal_equal_equal LIG.space equal' by LIG.space;
