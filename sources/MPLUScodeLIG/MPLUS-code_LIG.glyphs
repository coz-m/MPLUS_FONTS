	sub equal_period_period period' period by LIG.space;
	sub equal_period_period LIG.space period' by LIG.space;
	sub equal_slash_equal slash' equal by LIG.space;
	sub equal_slash_equal LIG.space equal' by LIG.space;
	sub exclam_asciitilde_asterisk asciitilde' asterisk by LIG.space;
	sub exclam_asciitilde_asterisk LIG.space asterisk' by LIG.space;
	sub exclam_equal_equal equal' equal by LIG.space;
	sub exclam_equal_equal LIG.space equal' by LIG.space;
	sub exclam_equal_question equal' question by LIG.space;
	sub exclam_equal_question LIG.space question' by LIG.space;
	sub greater_colon_colon colon' colon by LIG.space;
	sub greater_colon_colon LIG.space colon' by LIG.space;
	sub greater_colon_greater colon' greater by LIG.space;
	sub greater_colon_greater LIG.space greater' by LIG.space;
